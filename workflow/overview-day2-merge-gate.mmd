flowchart TD
    A["Change: code, prompt, or model"] --> B["Pull request"]
    B --> C["ci: lint, types, offline tests"]
    B --> D["eval-gate: grounding regression"]
    B --> E["redteam: adversarial suite and fail-closed proof"]
    C --> F{"All gates pass?"}
    D --> F
    E --> F
    F -- "no" --> G["Fix the change"]
    G --> B
    F -- "yes" --> H["Merge to main"]
    H --> I["The deploy pipeline ships the change"]
