flowchart TD
    A["Code, prompt, or model change"] --> PR["Pull request"]
    PR --> CI["ci workflow: ruff, mypy, offline pytest"]
    PR --> EG["eval-gate workflow: grounding regression"]
    PR --> RT["redteam workflow: 39 malicious cases plus fail-closed proof"]
    CI --> M{"Merge decision"}
    EG --> M
    RT --> M
    M -- "any gate fails" --> FIX["Fix the change"]
    FIX --> PR
    M -- "all gates pass" --> MAIN["main branch"]
    MAIN --> DEPLOY["Chapter 9 deploy pipeline, lives elsewhere"]
    DEPLOY --> CLOUD["Cloud Run deployment"]

    style M fill:#f9f,stroke:#333
    style MAIN fill:#cfc,stroke:#333
