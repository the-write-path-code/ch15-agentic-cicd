flowchart TD
    PR["<div style='min-width: 760px;'><b>Pull Request Trigger (Prompt / Model / Code)</b><br/>GitHub Actions launches offline evaluation workflow &bull; Loads 60-case Golden Set</div>"]

    Pipeline["<div style='min-width: 760px;'><b>1. Corpus Retrieval &amp; Policy-Constrained Generation</b><br/>Corpus Retrieval &rarr; Role-Based Clearance Filter &rarr; Active Prompt Completion</div>"]
    PR --> Pipeline

    Scoring["<div style='min-width: 760px;'><b>2. Multi-Dimensional Grounding Scoring &amp; Policy Gate</b><br/>Scores Retrieval Precision, Claim Grounding, Heuristics, and Answer Sufficiency<br/>Assigns Disposition: <code>ANSWER</code>, <code>QUALIFIED_ANSWER</code>, <code>ABSTAIN</code>, <code>BLOCK</code>, <code>HUMAN_REVIEW</code></div>"]
    Pipeline --> Scoring

    Gate["<div style='min-width: 760px;'><b>3. Baseline Comparison Gate vs Committed Baselines</b><br/>Evaluates delta against committed baseline &bull; Enforces zero regression on frozen cases</div>"]
    Scoring --> Gate

    subgraph Outcomes ["4. Merge Gate Decisions &amp; Egress"]
        direction LR
        Block["<div style='min-width: 320px;'><b>Merge Blocked</b><br/>Exit code &ne; 0<br/>Regression detected in CI gate</div>"]
        Pass["<div style='min-width: 320px;'><b>Merge Allowed</b><br/>Exit code 0 &bull; Metrics posted to PR<br/>Proceeds to deployment pipeline</div>"]
    end

    Gate -->|"Regression / Policy Fail"| Block
    Gate -->|"All Thresholds Met"| Pass

    classDef pr fill:#F8FAFC,stroke:#64748B,color:#000000,stroke-width:1.5px
    classDef pipe fill:#EBF5FF,stroke:#2563EB,color:#000000,stroke-width:1.5px
    classDef score fill:#EDE9FE,stroke:#7C3AED,color:#000000,stroke-width:1.5px
    classDef gate fill:#FEF9C3,stroke:#CA8A04,color:#000000,stroke-width:2px
    classDef block fill:#FEE2E2,stroke:#DC2626,color:#000000,stroke-width:2px
    classDef pass fill:#DCFCE7,stroke:#15803D,color:#000000,stroke-width:2px

    class PR pr
    class Pipeline pipe
    class Scoring score
    class Gate gate
    class Block block
    class Pass pass