flowchart TD
    A["Golden set, 60 cases"] --> B["Retrieve from the corpus"]
    B --> C["Filter restricted documents by role"]
    C --> D["Generate an answer from the active prompt"]
    D --> E["Score the answer: retrieval, heuristics, grounding, sufficiency"]
    E --> F{"Policy gate"}
    F --> G["ANSWER or QUALIFIED_ANSWER"]
    F --> H["ABSTAIN, BLOCK, or HUMAN_REVIEW"]
    G --> I{"Merge gates vs the committed baseline"}
    H --> I
    I -- "regression found" --> J["Merge blocked"]
    I -- "clean run" --> K["Merge allowed, metrics posted to the PR"]
