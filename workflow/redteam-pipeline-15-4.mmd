flowchart TD
    A["Incoming request plus retrieved documents"] --> B["Layer 1: input validator"]
    B -- "injection or malformed input" --> Z["Blocked with a precise reason"]
    B --> C["Layer 2: semantic guard"]
    C -- "escalation or override phrasing" --> Z
    C --> D["Layer 10: agent identity"]
    D -- "restricted source, claimed role, bad tool call" --> Z
    D --> E{"Retrieval in the request?"}
    E -- "no" --> Y["Pass"]
    E -- "yes" --> F["Layer 7: context isolator"]
    F -- "poisoned chunk or restricted document" --> Z
    F --> Y
    Y --> W["Audit log, one record per case"]
    Z --> W
    X["Scanner fails"] --> V["Fail closed: blocked, never passed"]
    V --> W
